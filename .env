# Demonstration only: this file shows one way to provide environment variables.
# Prefer keeping credentials out of the framework and local configuration files.
# Store secrets in Vault or another secrets manager, with references for each environment.
# Resolve those references in CI/runtime and inject the values as environment variables.
# Use a local .env only as a last resort, after adding it to .gitignore.
# This file is already ignored by Git. Fill in credentials locally if needed.

TEST_ENV=prod
API_EMAIL=admin@practicesoftwaretesting.com
API_PASSWORD=welcome01
